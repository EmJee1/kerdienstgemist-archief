{
  "name": "@kdg/discovery",
  "private": true,
  "type": "module",
  "imports": {
    "#*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix"
  },
  "dependencies": {
    "@kdg/config-typescript": "*",
    "@kdg/core": "*",
    "@kdg/feed": "*"
  }
}
